{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simple-survey-whgktjs",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SURVEY", "class_name": "SurveyRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SurveyRoom"] }]
}
